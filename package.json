{
  "name": "studysync_back",
  "version": "1.0.0",
  "description": "StudySync backend API — Express, PostgreSQL, JWT",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/run-sql.js",
