PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studysync
DB_USER=postgres
DB_PASSWORD=your_password
# Server

NODE_ENV=development

# PostgreSQL (connection string)
DB_URI=postgresql://user:password@localhost:5432/studysync
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
